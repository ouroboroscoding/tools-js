{
	"compilerOptions": {
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"jsx": "react",
		"lib": [ "es2020" ],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": false,
		"outDir": "./",
		"resolveJsonModule": true,
		"strict": true,
		"strictPropertyInitialization": false,
		"target": "esnext"
	},
	"include": ["./src"],
	"exclude": []
}